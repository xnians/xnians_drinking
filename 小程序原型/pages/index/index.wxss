/* pages/index/index.wxss —— 首页样式 */
.page { padding: 24rpx 32rpx 60rpx; }

.top { text-align: center; margin-top: 10rpx; }
.title { font-size: 48rpx; color: #2b7bb8; letter-spacing: 4rpx; font-weight: bold; }
.date { font-size: 26rpx; color: #7aa9c7; margin-top: 8rpx; }

.roles { display: flex; gap: 16rpx; margin: 32rpx 0 12rpx; }
.role {
  flex: 1; text-align: center; padding: 18rpx 8rpx; border-radius: 24rpx;
  background: #fff; font-size: 28rpx; color: #5a8aa8; border: 4rpx solid transparent;
}
.role.active { background: #4aa8e0; color: #fff; border-color: #4aa8e0; font-weight: bold; }

.ring-box {
  width: 320rpx; height: 320rpx; margin: 36rpx auto; border-radius: 50%;
  background: #fff; box-shadow: 0 8rpx 24rpx rgba(74,168,224,.18);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-num { font-size: 96rpx; font-weight: bold; color: #2b7bb8; }
.ring-sub { font-size: 28rpx; color: #7aa9c7; margin-top: 6rpx; }

.bar-bg { height: 24rpx; background: #d6ecf8; border-radius: 12rpx; overflow: hidden; margin: 8rpx 10rpx; }
.bar-fg { height: 100%; background: #4aa8e0; border-radius: 12rpx; transition: width .4s; }

.bubble {
  background: #fff; border-radius: 28rpx; padding: 28rpx 30rpx; margin: 28rpx 0;
  font-size: 30rpx; color: #3a6b8c; line-height: 1.7;
}
.who { font-size: 24rpx; color: #4aa8e0; font-weight: bold; margin-bottom: 8rpx; }

.btn {
  background: linear-gradient(135deg, #5bb6ee, #3d95d6); color: #fff;
  font-size: 36rpx; font-weight: bold; border-radius: 32rpx; margin-top: 20rpx;
}
.done { text-align: center; color: #2b9e6b; font-weight: bold; font-size: 30rpx; margin-top: 18rpx; }

.log { margin-top: 36rpx; }
.log-title { font-size: 28rpx; color: #5a8aa8; margin-bottom: 16rpx; }
.log-item {
  background: #fff; border-radius: 18rpx; padding: 20rpx 28rpx; margin-bottom: 16rpx;
  font-size: 28rpx; color: #3a6b8c; display: flex; justify-content: space-between;
}
.empty { font-size: 26rpx; color: #9cc3d8; text-align: center; padding: 20rpx; }
